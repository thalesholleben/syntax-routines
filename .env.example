# Opcional. O caminho normal e Ajustes > Configurar e-mail, no painel: la voce escolhe Gmail ou outro SMTP, a conta e
# quem recebe, e a senha fica cifrada com a DPAPI do Windows. Este arquivo continua valendo para quem prefere (copie
# para .env na raiz do projeto; ele fica fora do git), e a conta salva no painel tem prioridade sobre ele.
# Sem conta nenhuma o app sobe normalmente, so nao envia e-mail (Ajustes mostra "Nao configurado").

# Servidor SMTP. Padrao: Gmail / Google Workspace com STARTTLS na 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true so na porta 465 (TLS direto). Deixe false na 587.
SMTP_SECURE=false
# Conta que envia. No Google, com verificacao em duas etapas, use uma senha de app (16 caracteres).
SMTP_USER=avisos@seudominio.com.br
SMTP_PASS=
# Remetente que aparece no e-mail (precisa ser autorizado na conta acima).
MAIL_FROM_EMAIL=avisos@seudominio.com.br
MAIL_FROM_NAME=Syntax Routines
